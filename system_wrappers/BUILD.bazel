    ],
    copts = COPTS,
    deps = [
        ":field_trial",
        "//api:array_view",
        "//api/units:timestamp",
        "//modules:module_api_public",
        "//rtc_base:checks",
        "//rtc_base:logging",
        "//rtc_base:rtc_numerics",
        "//rtc_base:safe_conversions",
        "//rtc_base:timeutils",
        "//rtc_base/synchronization:mutex",
        "//rtc_base/system:arch",
        "//rtc_base/system:rtc_export",
        "@com_google_absl//absl/types:optional",
    ],

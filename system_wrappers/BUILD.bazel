load("//:defs.bzl", "COPTS")

package(
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "denormal_disabler",
    srcs = ["source/denormal_disabler.cc"],
    hdrs = ["include/denormal_disabler.h"],
    copts = COPTS,
    deps = [
        "//rtc_base:checks",
        "//rtc_base/system:arch",
    ],
)

cc_library(
    name = "field_trial",
    srcs = ["source/field_trial.cc"],
    hdrs = ["include/field_trial.h"],
    copts = COPTS,
    deps = [
        "//experiments:registered_field_trials",
        "//rtc_base:checks",
        "//rtc_base:logging",
        "//rtc_base:stringutils",
        "//rtc_base/containers:flat_set",
        "@com_google_absl//absl/algorithm:container",
        "@com_google_absl//absl/strings",
    ],
)

cc_library(
    name = "metrics",
    srcs = ["source/metrics.cc"],
    hdrs = ["include/metrics.h"],
    copts = COPTS,
    deps = [
        "//rtc_base:checks",
        "//rtc_base:macromagic",
        "//rtc_base:stringutils",
        "//rtc_base/synchronization:mutex",
        "@com_google_absl//absl/strings",
    ],
)

cc_library(
    name = "system_wrappers",
    srcs = [
        "source/clock.cc",
        "source/cpu_features.cc",
        "source/cpu_features_linux.cc",
        "source/cpu_info.cc",
        "source/rtp_to_ntp_estimator.cc",
        "source/sleep.cc",

load("//:defs.bzl", "COPTS")

package(
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "aec3_config",
    srcs = ["echo_canceller3_config.cc"],
    hdrs = ["echo_canceller3_config.h"],
    copts = COPTS,
    deps = [
        "//rtc_base:checks",
        "//rtc_base:safe_minmax",
        "//rtc_base/system:rtc_export",
    ],
)

cc_library(
    name = "aec3_factory",
    srcs = ["echo_canceller3_factory.cc"],
    hdrs = ["echo_canceller3_factory.h"],
    copts = COPTS,
    deps = [
        ":aec3_config",
        ":echo_control",
        "//modules/audio_processing/aec3",
        "//rtc_base/system:rtc_export",
    ],
)

cc_library(
    name = "audio_frame_api",
    srcs = [
        "audio_frame.cc",
        "channel_layout.cc",
    ],
    hdrs = [
        "audio_frame.h",
        "channel_layout.h",
    ],
    copts = COPTS,
    deps = [
        "//api:rtp_packet_info",
        "//rtc_base:checks",
        "//rtc_base:logging",
        "//rtc_base:macromagic",
        "//rtc_base:timeutils",
    ],
)

cc_library(
    name = "echo_control",
    hdrs = ["echo_control.h"],
    copts = COPTS,
    deps = ["//rtc_base:checks"],
)

load("//:defs.bzl", "COPTS")

package(
    default_visibility = ["//:__subpackages__"],
)

cc_library(
    name = "array_view",
    hdrs = ["array_view.h"],
    copts = COPTS,
    deps = [
        "//rtc_base:checks",
        "//rtc_base:type_traits",
    ],
)

cc_library(
    name = "function_view",
    hdrs = ["function_view.h"],
    copts = COPTS,
    deps = ["//rtc_base:checks"],
)

cc_library(
    name = "refcountedbase",
    hdrs = ["ref_counted_base.h"],
    copts = COPTS,
    deps = [
        "//rtc_base:macromagic",
        "//rtc_base:refcount",
    ],
)

cc_library(
    name = "rtp_headers",
    srcs = ["rtp_headers.cc"],
    hdrs = ["rtp_headers.h"],
    copts = COPTS,
    deps = [
        ":array_view",
        "//api/units:timestamp",
        "//api/video:video_rtp_headers",
        "@com_google_absl//absl/types:optional",
    ],
)

cc_library(
    name = "rtp_packet_info",
    srcs = ["rtp_packet_info.cc"],
    hdrs = [
        "rtp_packet_info.h",
        "rtp_packet_infos.h",
    ],
    copts = COPTS,
    deps = [
        ":array_view",
        ":refcountedbase",
        ":rtp_headers",
        ":scoped_refptr",
        "//api/units:timestamp",
        "//rtc_base:rtc_base_approved",
        "//rtc_base/system:rtc_export",
        "@com_google_absl//absl/types:optional",
    ],
)

cc_library(
    name = "scoped_refptr",
    hdrs = ["scoped_refptr.h"],
    copts = COPTS,
)

cc_library(
    name = "sequence_checker",
    hdrs = ["sequence_checker.h"],
    copts = COPTS,
    deps = [
        "//rtc_base:checks",
        "//rtc_base:macromagic",
        "//rtc_base/synchronization:sequence_checker_internal",
    ],
)
